<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ThreatAwareness</AssemblyName>
    <Version>0.2.1</Version>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LogLibrary"><HintPath>$(GameManagedDir)/LogLibrary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameManagedDir)' == ''" Text="Set GameManagedDir to the game's Managed folder, or use build.ps1 -GameDir with your game or dedicated server installation path." />
    <Error Condition="'$(GameManagedDir)' != '' and !Exists('$(GameManagedDir)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found in GameManagedDir. A v3.3 game or dedicated server installation is required." />
  </Target>
</Project>
